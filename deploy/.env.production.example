APP_NAME="BOC Visa Portal"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://visa.example.bh

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visa
DB_USERNAME=visa
DB_PASSWORD=

# QUEUE_CONNECTION=redis requires the php8.3-redis extension (installed in README "Server packages").
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

MAIL_MAILER=ses
MAIL_FROM_ADDRESS=visa@example.bh
MAIL_FROM_NAME="BOC Visa Portal"

AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=boc-visa-files
BACKUP_BUCKET=boc-visa-backups
VISA_DISK=s3

TESSERACT_PATH=/usr/bin/tesseract
TAP_SECRET_KEY=
ADMIN_IP_ALLOWLIST=
VISA_FILE_RETENTION_DAYS=90
INVOICE_ADDRESS="Manama, Kingdom of Bahrain"
